# This is a comment
#Another comment

CHIP Intermediate { # A comment at the end of the line
  INPUT in : { a : bits 32, b : bits 32 }
  OUTPUT out : { c : bits 8, d : bits 9 }
  STATES dff : bits 1, fft : bits 9, recState : {a : bits 1}

  out_c := Nand { a=in.a, b=in.b }
  out_d := Not out_c
  # Another one!
  out := { c=out_c, d=out_d }
}

# And a comment here as well
