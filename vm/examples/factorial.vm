function mul 0
    (* Base case: x = 0 *)
    push argument 0
    push constant 0
    eq
    if-goto base
    (* Recurse: x*y = (x - 1)*y + y *)
    push argument 0
    push constant 1
    sub
    push argument 1
    call mul 2
    push argument 1
    add
    return
    label base
    push constant 0
    return

function fact 0
    (* Base case: x = 0 *)
    push argument 0
    push constant 0
    eq
    if-goto base
    (* Recurse: x! = x * (x - 1)! *)
    push argument 0
    push constant 1
    sub
    call fact 1
    push argument 0
    call mul 2
    return
    label base
    push constant 1
    return

function main 0
    (* Computing 5! *)
    push constant 5
    call fact 1
    return

