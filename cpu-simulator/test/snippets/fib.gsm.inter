# Generate the first n Fibonacci numbers and storing it in the
# main memory, starting from address k.
# Initially, RAM[0] stores n and RAM[1] stores k.


ld r1 r0 0
ld r2 r0 1

addi r3 r0 0
addi r5 r0 0
addi r6 r0 1

beq r3 r1 7
add r4 r2 r3
st r5 r4 0
add r6 r6 r5
sub r5 r6 r5
addi r3 r3 1
j -6

j 0

